page NotFound

import { IconArrowRight } from "tylix-icons"

title "Page not found · Tylix"

uses
  Site

template
  <section class="tx-container min-h-[65vh] flex flex-col items-center justify-center text-center py-24">
    <p class="font-mono text-sm text-faint">404</p>
    <h1 class="tx-h2 mt-4 text-ink">This page doesn't exist.</h1>
    <p class="tx-lead mt-4 max-w-md">The link may be old, or the page moved. Searching the docs usually finds it.</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <button type="button" onclick="{{ Site.openSearch() }}" class="tx-btn tx-btn-outline">Search the docs <kbd>/</kbd></button>
      <a href="/" class="tx-btn tx-btn-primary">Go home <IconArrowRight class="w-4 h-4" /></a>
    </div>
  </section>
