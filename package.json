{
  "name": "tylix-docs",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tylix dev",
    "build": "tylix build",
    "start": "tylix start",
    "migrate": "tylix migrate",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "doctor": "tylix doctor",
    "tinker": "tylix tinker",
    "css:build": "tailwindcss -i ./app/tailwind-input.css -o ./public/tailwind.css",
