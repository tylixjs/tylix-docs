component DocsView

// One documentation page: sidebar, the rendered Markdown, the on-page
// table of contents and previous/next links. Content comes from
// content/docs/<slug>.md through /api/docs/page/:slug.

import { IconArrowLeft, IconArrowRight, IconPencil, IconChevronDown, IconChevronRight, IconMenu } from "tylix-icons"
import PageLoading from "./PageLoading"

// The sidebar keeps its place between pages: its scroll position is saved
// as you scroll it and restored on the next page, and the nav is cached for
// the tab so the sidebar is drawn before the API answers. When the current
// page's link would be out of view, the sidebar scrolls it to the middle.

props
  slug: string

state
  nav: []
  doc: null
  loading: true
  gone: false
  error: ""
  activeId: ""
  menuOpen: false
  observer: null

action
  sideClass(itemSlug) {
    return itemSlug is this.slug ? "tx-side-link is-active" : "tx-side-link"
  }

  formatDate(value) {
    if not value {
      return ""
    }
    return new Date(value).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  }

  toggleMenu() {
    this.menuOpen = not this.menuOpen
  }

  watchHeadings() {
    const headings = Array.from(document.querySelectorAll(".doc h2[id], .doc h3[id]"))
    if headings.length is 0 {
      return null
    }
    if this.observer {
      this.observer.disconnect()
    }
    const visible = new Set()
    this.observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if entry.isIntersecting {
          visible.add(entry.target.id)
        } else {
          visible.delete(entry.target.id)
        }
      }
      const first = headings.find((h) => visible.has(h.id))
      if first {
        this.activeId = first.id
      }
    }, { rootMargin: "-72px 0px -65% 0px", threshold: 0 })
    for (const h of headings) {
      this.observer.observe(h)
    }
    this.activeId = headings[0].id
  }

  readSession(key) {
    try {
      return sessionStorage.getItem(key)
    } catch (err) {
      return null
    }
  }

  writeSession(key, value) {
    try {
      sessionStorage.setItem(key, value)
    } catch (err) {
      return null
    }
  }

  keepSidebarPlace() {
    const side = document.querySelector(".tx-sidebar")
    if not side {
      return null
    }
    const saved = this.readSession("tx-docs:side-scroll")
    if saved {
      side.scrollTop = Number(saved)
    }
    const active = side.querySelector(".tx-side-link.is-active")
    if active {
      const box = side.getBoundingClientRect()
      const link = active.getBoundingClientRect()
      if link.top < box.top + 48 or link.bottom > box.bottom - 48 {
        side.scrollTop = side.scrollTop + (link.top - box.top) - side.clientHeight / 2 + link.height / 2
      }
    }
    if side.hasAttribute("data-place-watched") {
      return null
    }
    side.setAttribute("data-place-watched", "")
    side.addEventListener("scroll", () => this.writeSession("tx-docs:side-scroll", String(Math.round(side.scrollTop))), { passive: true })
  }

  afterRender() {
    this.keepSidebarPlace()
    this.watchHeadings()
    const hash = decodeURIComponent(window.location.hash.slice(1))
    if hash {
      const target = document.getElementById(hash)
      if target {
        target.scrollIntoView()
        this.activeId = hash
      }
    }
  }

onMount
  async {
    const cachedNav = this.readSession("tx-docs:nav")
    if cachedNav {
      try {
        this.nav = JSON.parse(cachedNav)
        requestAnimationFrame(() => this.keepSidebarPlace())
      } catch (err) {
        this.nav = []
      }
    }

    const [navResult, pageResult] = await Promise.all([
      useApi("/api/docs/nav"),
      useApi(`/api/docs/page/${encodeURIComponent(this.slug)}`)
    ])

    if navResult.ok {
      this.nav = navResult.data.data
      this.writeSession("tx-docs:nav", JSON.stringify(this.nav))
    }

    if pageResult.ok {
      this.doc = pageResult.data.data
      document.title = `${this.doc.title} · Tylix Docs`
      if this.doc.description {
        const meta = document.querySelector('meta[name="description"]')
        if meta {
          meta.setAttribute("content", this.doc.description)
        }
      }
    } else if pageResult.status is 404 {
      this.gone = true
      document.title = "Page not found · Tylix Docs"
    } else {
      this.error = pageResult.error ?? "This page couldn't be loaded."
    }

    this.loading = false
    requestAnimationFrame(() => this.afterRender())
  }

template
  <div class="tx-container tx-container-wide">
    <div class="lg:hidden sticky z-30 -mx-5 sm:-mx-8 px-5 sm:px-8 border-b border-line bg-canvas/90 backdrop-blur" style="top: var(--tx-header-h)">
      <button type="button" onclick="{{ toggleMenu() }}" class="w-full h-12 flex items-center gap-2 text-sm text-soft" aria-expanded="{{ menuOpen }}" aria-controls="tx-docs-menu">
        <IconMenu class="w-4 h-4 text-muted" />
        <span class="font-medium text-ink">Menu</span>
{{#if doc}}
        <IconChevronRight class="w-3.5 h-3.5 text-faint" />
        <span class="truncate">{{ doc.title }}</span>
{{/if}}
        <span class="ml-auto text-muted transition-transform" class:rotate-180="{{ menuOpen }}"><IconChevronDown class="w-4 h-4" /></span>
      </button>
{{#if menuOpen}}
      <nav id="tx-docs-menu" class="pb-5 max-h-[70vh] overflow-y-auto" aria-label="Documentation">
{{#each section in nav}}
        <div class="mt-4">
          <p class="tx-side-title">{{ section.title }}</p>
{{#each item in section.items}}
          <a href="{{ `/docs/${item.slug}` }}" class="{{ sideClass(item.slug) }}">{{ item.title }}</a>
{{/each}}
        </div>
{{/each}}
      </nav>
{{/if}}
    </div>

    <div class="tx-docs">
      <aside class="tx-sidebar" aria-label="Documentation">
        <nav>
{{#each section in nav}}
          <div class="mb-7">
            <p class="tx-side-title">{{ section.title }}</p>
            <div class="flex flex-col gap-px">
{{#each item in section.items}}
              <a href="{{ `/docs/${item.slug}` }}" class="{{ sideClass(item.slug) }}" aria-current="{{ item.slug is slug ? 'page' : null }}">
                <span>{{ item.title }}</span>
{{#if item.badge}}
                <span class="text-[10px] font-semibold uppercase tracking-wide text-mint">{{ item.badge }}</span>
{{/if}}
              </a>
{{/each}}
            </div>
          </div>
{{/each}}
        </nav>
      </aside>

      <div class="min-w-0 pt-8 lg:pt-10 pb-20">
{{#if loading}}
        <div class="max-w-[46rem]" aria-busy="true">
          <PageLoading label="Loading the page" />
        </div>
{{#else if gone}}
        <div class="max-w-[46rem] py-10">
          <p class="tx-eyebrow mb-3">404</p>
          <h1 class="text-3xl font-semibold tracking-[-0.03em] text-ink">This page doesn't exist</h1>
          <p class="mt-3 text-muted">It may have moved. Search the docs, or start from the introduction.</p>
          <a href="/docs" class="tx-btn tx-btn-outline mt-7">Go to the introduction</a>
        </div>
{{#else if error}}
        <div class="max-w-[46rem] py-10">
          <h1 class="text-2xl font-semibold text-ink">Something went wrong</h1>
          <p class="mt-2 text-muted">{{ error }}</p>
        </div>
{{#else if doc}}
        <article class="max-w-[46rem]">
          <p class="text-[13px] font-medium text-brand dark:text-link mb-3">{{ doc.section }}</p>
          <h1 class="text-[2.25rem] sm:text-[2.625rem] leading-[1.1] font-semibold tracking-[-0.035em] text-ink">{{ doc.title }}</h1>
{{#if doc.description}}
          <p class="mt-4 text-lg leading-relaxed text-muted">{{ doc.description }}</p>
{{/if}}
          <div class="doc mt-9">{{@html doc.html}}</div>

          <div class="mt-16 pt-6 border-t border-line flex flex-wrap items-center justify-between gap-3 text-sm">
            <a href="{{ doc.editUrl }}" class="inline-flex items-center gap-1.5 text-muted hover:text-ink transition-colors" target="_blank" rel="noopener noreferrer">
              <IconPencil class="w-3.5 h-3.5" /> Edit this page on GitHub
            </a>
            <span class="text-faint text-xs">Updated {{ formatDate(doc.updatedAt) }}</span>
          </div>

          <nav class="tx-pager mt-8" aria-label="Previous and next page">
{{#if doc.prev}}
            <a href="{{ `/docs/${doc.prev.slug}` }}">
              <span class="inline-flex items-center gap-1"><IconArrowLeft class="w-3 h-3" /> Previous</span>
              <strong>{{ doc.prev.title }}</strong>
            </a>
{{#else}}
            <div></div>
{{/if}}
{{#if doc.next}}
            <a href="{{ `/docs/${doc.next.slug}` }}" class="text-right items-end">
              <span class="inline-flex items-center gap-1">Next <IconArrowRight class="w-3 h-3" /></span>
              <strong>{{ doc.next.title }}</strong>
            </a>
{{/if}}
          </nav>
        </article>
{{/if}}
      </div>

      <aside class="tx-toc" aria-label="On this page">
{{#if doc and doc.toc.length > 0}}
        <p class="text-xs font-semibold text-ink mb-3">On this page</p>
        <nav>
{{#each item in doc.toc}}
          <a href="{{ `#${item.id}` }}" class:is-sub="{{ item.depth is 3 }}" class:is-active="{{ item.id is activeId }}">{{ item.text }}</a>
{{/each}}
        </nav>
{{/if}}
      </aside>
    </div>
  </div>
