component CodeShowcase

// A code window with file tabs. The code is highlighted on the server
// (content/snippets/*.md, /api/site/snippets) with the editor themes.

state
  snippets: {}
  active: "page"
  tabs: [
    { key: "page", label: "Todos.tyx" },
    { key: "model", label: "Todo.ts" },
    { key: "job", label: "SendInvoice.js" }
  ]

onMount
  async {
    const result = await useApi("/api/site/snippets")
    if result.ok {
      this.snippets = result.data.data
    }
  }

template
  <div class="tx-window">
    <div class="flex items-center gap-1 px-2 border-b border-line overflow-x-auto" role="tablist">
      <span class="hidden sm:flex gap-1.5 px-2.5 mr-1" aria-hidden="true">
        <i class="w-2.5 h-2.5 rounded-full bg-line-strong"></i>
        <i class="w-2.5 h-2.5 rounded-full bg-line-strong"></i>
        <i class="w-2.5 h-2.5 rounded-full bg-line-strong"></i>
      </span>
{{#each tab in tabs}}
      <button type="button" role="tab" class="tx-tab" class:is-active="{{ tab.key is active }}" aria-selected="{{ tab.key is active }}" onclick="{{ active = tab.key }}">{{ tab.label }}</button>
{{/each}}
    </div>
    <div class="h-[26rem] overflow-auto">
{{#if snippets[active]}}
      {{@html snippets[active]}}
{{#else}}
      <div class="p-6 space-y-3" aria-hidden="true">
        <div class="tx-skel w-1/3"></div>
        <div class="tx-skel w-1/2"></div>
        <div class="tx-skel w-2/5"></div>
        <div class="tx-skel w-3/5"></div>
      </div>
{{/if}}
    </div>
  </div>
