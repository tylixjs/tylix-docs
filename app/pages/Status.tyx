page Status

// Live state, 90-day uptime and announcements from the Ashmif Hub, through
// /api/site/status. Incidents and maintenance are posted in the Hub.

import PageLoading from "./components/PageLoading"

title "Status · Tylix"

state
  report: null
  loading: true
  error: ""
  stale: false
  hover: null
  checkedAt: ""

computed
  overall() {
    return this.report ? this.report.state : "unknown"
  }

  headline() {
    if this.active.some(a => a.kind is "incident") {
      return "Investigating an incident"
    }
    if this.overall is "operational" {
      return "All systems operational"
    }
    if this.overall is "outage" {
      return "Service disruption"
    }
    return "Status unknown"
  }

  active() {
    return this.report ? this.report.announcements.filter(a => a.phase is "active") : []
  }

  upcoming() {
    return this.report ? this.report.announcements.filter(a => a.phase is "upcoming") : []
  }

  resolved() {
    return this.report ? this.report.announcements.filter(a => a.phase is "resolved") : []
  }

  uptimeLabel() {
    const p = this.report ? this.report.uptime_percent : null
    return p is null or p is undefined ? "No data" : `${Number(p).toFixed(2)}%`
  }

action
  barClass(day) {
    if day.uptime_percent is null {
      return "is-none"
    }
    if day.uptime_percent < 95 {
      return "is-down"
    }
    if day.uptime_percent < 99.9 {
      return "is-warn"
    }
    return ""
  }

  dayLabel(day) {
    const date = new Date(day.day + "T00:00:00Z").toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" })
    if day.uptime_percent is null {
      return `${date}: not monitored`
    }
    const down = day.down_minutes > 0 ? `, ${day.down_minutes} min down` : ", no downtime"
    return `${date}: ${Number(day.uptime_percent).toFixed(2)}%${down}`
  }

  formatWhen(value) {
    if not value {
      return ""
    }
    return new Date(value).toLocaleString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" })
  }

  kindLabel(kind) {
    if kind is "incident" {
      return "Incident"
    }
    if kind is "maintenance" {
      return "Maintenance"
    }
    return "Notice"
  }

  async load() {
    const result = await useApi("/api/site/status")
    if result.ok {
      this.report = result.data.data
      this.stale = result.data.stale
      this.error = ""
    } else {
      this.error = result.error ?? "Status is unavailable right now."
    }
    this.checkedAt = new Date().toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" })
    this.loading = false
  }

onMount
  async {
    await this.load()
    setInterval(() => this.load(), 60000)
  }

template
  <div class="tx-container py-16 sm:py-20 max-w-4xl">
    <header>
      <p class="tx-eyebrow">Status</p>
      <h1 class="tx-h2 mt-4 text-ink">Tylix services</h1>
      <p class="tx-lead mt-4">The tylix.dev website, docs and API, with uptime over the last 90 days.</p>
    </header>

{{#if loading}}
    <div class="mt-10" aria-busy="true"><PageLoading label="Loading status" /></div>
{{#else if error and not report}}
    <div class="mt-10 tx-panel p-8 text-center">
      <p class="font-medium text-ink">{{ error }}</p>
      <p class="mt-2 text-sm text-muted">We'll retry automatically every minute.</p>
    </div>
{{#else}}
    <div class="mt-10 tx-panel px-6 py-5 flex flex-wrap items-center gap-4" class:text-mint="{{ overall is 'operational' and active.length is 0 }}" class:text-coral="{{ overall is 'outage' or active.some(a => a.kind is 'incident') }}" class:text-muted="{{ overall is 'unknown' and active.length is 0 }}">
      <span class="tx-pulse"></span>
      <p class="text-lg font-semibold tracking-[-0.01em] text-ink">{{ headline }}</p>
      <p class="ml-auto text-xs text-muted">Checked {{ checkedAt }}{{ report.last_seen_at ? " · last heartbeat " + formatWhen(report.last_seen_at) : "" }}</p>
    </div>

{{#if stale}}
    <p class="mt-3 text-sm text-peach">Showing the last saved report. The status feed couldn't be reached just now.</p>
{{/if}}

{{#each a in active}}
    <article class="mt-4 rounded-xl border p-6" class:border-coral="{{ a.kind is 'incident' }}" class:border-peach="{{ a.kind is 'maintenance' }}" class:border-line="{{ a.kind is 'info' }}">
      <p class="text-xs font-semibold uppercase tracking-[0.06em]" class:text-coral="{{ a.kind is 'incident' }}" class:text-peach="{{ a.kind is 'maintenance' }}" class:text-brand="{{ a.kind is 'info' }}">{{ kindLabel(a.kind) }} · ongoing</p>
      <h2 class="mt-2 text-lg font-semibold text-ink">{{ a.title }}</h2>
      <div class="doc mt-2 text-[15px]">{{@html a.html}}</div>
      <p class="mt-3 text-xs text-muted">Started {{ formatWhen(a.starts_at) }}</p>
    </article>
{{/each}}

    <section class="mt-10 tx-panel p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="font-semibold text-ink">tylix.dev</h2>
        <p class="text-sm text-muted"><span class="font-semibold text-ink">{{ uptimeLabel }}</span> uptime · 90 days</p>
      </div>
      <div class="tx-bars mt-5" role="img" aria-label="{{ `Daily uptime for the last 90 days: ${uptimeLabel} overall` }}">
{{#each day in report.days}}
        <i class="{{ barClass(day) }}" title="{{ dayLabel(day) }}" onmouseenter="{{ hover = day }}" onmouseleave="{{ hover = null }}"></i>
{{/each}}
      </div>
      <div class="mt-3 flex items-center justify-between text-xs text-faint">
        <span>90 days ago</span>
{{#if hover}}
        <span class="text-soft">{{ dayLabel(hover) }}</span>
{{/if}}
        <span>Today</span>
      </div>
    </section>

{{#if upcoming.length > 0}}
    <section class="mt-12">
      <h2 class="text-sm font-semibold text-ink">Scheduled</h2>
{{#each a in upcoming}}
      <article class="mt-4 border-l-2 border-peach pl-5">
        <p class="text-xs text-muted">{{ formatWhen(a.starts_at) }}{{ a.ends_at ? " – " + formatWhen(a.ends_at) : "" }}</p>
        <h3 class="mt-1 font-semibold text-ink">{{ a.title }}</h3>
        <div class="doc mt-1 text-[15px]">{{@html a.html}}</div>
      </article>
{{/each}}
    </section>
{{/if}}

    <section class="mt-12">
      <h2 class="text-sm font-semibold text-ink">Past notices</h2>
{{#each a in resolved}}
      <article class="mt-5 pb-5 border-b border-line">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="font-semibold text-ink">{{ a.title }}</h3>
          <span class="text-xs text-muted">{{ kindLabel(a.kind) }} · resolved {{ formatWhen(a.ends_at or a.starts_at) }}</span>
        </div>
        <div class="doc mt-1 text-[15px]">{{@html a.html}}</div>
      </article>
{{#else}}
      <p class="mt-3 text-sm text-muted">No incidents or maintenance recently.</p>
{{/each}}
    </section>
{{/if}}
  </div>
