component BadgeIcon

// The icon of a playground badge (public/playground/workspace.js names it).
// It fills its box: size it with the element around it.

import { IconPaintBrush, IconLayers, IconPuzzlePiece, IconBolt, IconRocket, IconCalculator, IconFlag, IconSearch, IconWindow, IconCube } from "tylix-icons"

props
  icon: string

template
{{#if icon is "paint"}}<IconPaintBrush class="pg-badge-svg" />{{#else if icon is "layers"}}<IconLayers class="pg-badge-svg" />{{#else if icon is "puzzle"}}<IconPuzzlePiece class="pg-badge-svg" />{{#else if icon is "bolt"}}<IconBolt class="pg-badge-svg" />{{#else if icon is "calculator"}}<IconCalculator class="pg-badge-svg" />{{#else if icon is "flag"}}<IconFlag class="pg-badge-svg" />{{#else if icon is "search"}}<IconSearch class="pg-badge-svg" />{{#else if icon is "window"}}<IconWindow class="pg-badge-svg" />{{#else if icon is "cube"}}<IconCube class="pg-badge-svg" />{{#else}}<IconRocket class="pg-badge-svg" />{{/if}}
